{
    "name": "archive-markdown-editor",
    "version": "1.2.7",
    "description": "A simple, beautiful and powerful markdown & mdz file editor.",
    "main": "./out/main/index.js",
    "author": "Scott Smith",
    "keywords": [
        "archive",
        "markdown",
        "editor",
        "archive markdown editor"
    ],
    "files": [
        "README.md",
        "LICENSE",
        "package.json"
    ],
    "homepage": "https://scottsmith666.github.io/",
    "license": "MIT",
    "scripts": {
        "format": "prettier --write .",
        "lint": "eslint --cache .",
        "start": "electron .",
        "dev": "electron-vite dev",
        "build": "electron-vite build && node ./utils/copy-mathjax && node ./utils/syncver.js",
        "build:unpack": "npm run build && electron-builder --dir",
        "build:win": "npm run build && electron-builder --win",
        "build:mac": "npm run build && electron-builder --mac",
        "build:linux": "npm run build && electron-builder --linux",
        "clean": "node ./utils/clear.js"
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "@mdit/plugin-alert": "^2.2.0",
        "@toycode/markdown-it-class": "^1.2.4",
        "@vue/devtools-api": "^8.2.1",
        "better-sqlite3": "^13.2.0",
        "docx-preview": "^0.4.1",
        "dompurify": "^3.5.0",
        "htmlparser2": "^12.0.0",
        "markdown-it": "^15.0.3",
        "markdown-it-emoji": "^3.1.0",
        "markdown-it-mark": "^4.0.0",
        "markdown-it-regex": "^0.2.2",
        "markdown-it-task-lists": "^2.1.1",
        "markdown-it-textual-uml": "^0.17.1",
        "morphdom": "^2.7.8",
        "pinia": "^4.1.0",
        "prismjs": "^1.30.0",
        "vite-plugin-monaco-editor-nls": "^3.0.1",
        "vue-router": "^5.5.2",
        "vue3-zoomer": "^1.0.11",
        "x-data-spreadsheet": "^1.1.9",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config": "^3.0.0",
        "@electron-toolkit/eslint-config-prettier": "^3.0.1",
        "@vitejs/plugin-vue": "^6.0.11",
        "electron": "^45.5.0",
        "electron-builder": "^26.18.0",
        "electron-rebuild": "^3.2.9",
        "electron-vite": "^6.0.0",
        "eslint": "^10.15.0",
        "eslint-plugin-vue": "^10.12.1",
        "less": "^4.9.1",
        "prettier": "^3.10.1",
        "vite": "^8.4.0",
        "vue": "^3.5.46",
        "vue-eslint-parser": "^10.4.2"
    }
}

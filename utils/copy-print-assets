#!/usr/bin/env node

// 打印页（src/renderer/ame-print.html）用的 Prism 素材要出现在渲染产物目录里，
// 理由和 copy-mathjax 一样：这些文件在页面里是经典 <script src>，vite 不会打包它们，
// 只保留原样引用（build 时会看到 “can't be bundled without type=module” 的提示），
// 所以必须自己搬过去。为什么非要用经典 script 而不是 import，见 src/renderer/libs/Prism/README.md。

import path from "path";
import fs from "fs";
import {fileURLToPath} from 'url';
import {dirname} from 'path';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);

const startDir = path.join(__dirname, "..", "src", "renderer", "libs", "Prism");
const destDir = path.join(__dirname, "..", "out", "renderer", "libs", "Prism");

fs.cp(startDir, destDir, {
    recursive: true,
}, (err) => {
    if (err) {
        console.error('目录拷贝出错:', err);
    } else {
        console.log(`将:${startDir}拷贝至 -> ${destDir}`);
        console.log("Prism copy successfully! Enjoy!");
    }
});
